# Email delivery for the contact form (choose one provider). The API route at src/app/api/contact/route.ts
# gracefully logs submissions when unset so the form still works in development.
RESEND_API_KEY=
CONTACT_TO_EMAIL=intake@baronelaw.com
CONTACT_FROM_EMAIL=website@baronelaw.com
# Optional Google Maps embed key (a keyless embed is used by default)
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
