# AfriPulse Times — environment template
#
# Copy this file to `.env.local` and fill in the real values from
# supabase.com → your project → Project Settings → API.
#
# NOTE: Vite only exposes variables prefixed with VITE_ to browser code, so the
# public Supabase values are named VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
# The anon key is meant to be public (protected by Row Level Security) — but the
# service_role key must NEVER go in this file or anywhere client-side.

# --- Browser (Vite) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Server (Vercel serverless functions, e.g. /api/pull-wire) ---
# Same project URL, plus the SECRET service_role key (bypasses RLS to insert
# wire articles). Never expose the service_role key to the browser.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Shared secret that protects /api/pull-wire. Vercel cron sends it automatically
# once set in the project env. Generate one, e.g.: openssl rand -hex 32
CRON_SECRET=YOUR_RANDOM_CRON_SECRET

# Buttondown newsletter API key (used by /api/subscribe). Free tier available.
# Find it at buttondown.email -> Settings -> Programming -> API.
BUTTONDOWN_API_KEY=YOUR_BUTTONDOWN_API_KEY

# Anthropic (Claude) API key — used by /api/translate to translate articles into
# French + Arabic. Get one at console.anthropic.com -> API Keys. (Pay-as-you-go.)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# --- Investor-enquiry email notifications (used by /api/contact) ---
# Optional. When both RESEND_API_KEY and LEADS_NOTIFY_TO are set, a notification
# email is sent to the team each time someone submits the investor form. If
# either is missing, the enquiry is still saved to Supabase — only the email is
# skipped. Get a key at resend.com -> API Keys (free tier available).
RESEND_API_KEY=YOUR_RESEND_API_KEY
# Who receives the alerts (comma-separated for multiple).
LEADS_NOTIFY_TO=you@example.com
# The "from" address. To send from your own domain, verify it in Resend first;
# otherwise leave this as Resend's shared sender (only delivers to your own
# account email until a domain is verified).
LEADS_NOTIFY_FROM=AfriPulse Times <onboarding@resend.dev>
